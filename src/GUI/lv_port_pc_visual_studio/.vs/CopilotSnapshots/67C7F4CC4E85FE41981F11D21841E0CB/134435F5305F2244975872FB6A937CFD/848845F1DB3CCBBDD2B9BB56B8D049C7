static void ps_update_v33_needle(void)
{
    static char buffer[32];
    static const int32_t scale_w = 60;
    static const int32_t scale_h = 200;
    static const int32_t right_offset = 150;

    int32_t v33_x_loc = HORI_RES / 2 - scale_w / 2 + right_offset;
    int32_t v33_y_loc = VERT_RES / 2 - scale_h / 2;

    V33_set_needle(ui_objects.v33_needle, v33_rail_voltage, scale_h, scale_w, 
                   v33_x_loc, v33_y_loc, 3.10, 3.50, ui_objects.v33_needle_width);

    /* Update current display */
    snprintf(buffer, sizeof(buffer), "%.2f A", v33_rail_current);
    lv_label_set_text(ui_objects.text_v33_current, buffer);
}

